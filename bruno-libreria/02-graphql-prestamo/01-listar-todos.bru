meta {
  name: Listar todos
  type: graphql
  seq: 1
}

post {
  url: {{urlLibreria}}/graphql
  body: graphql
  auth: basic
}

auth:basic {
  username: {{usuario}}
  password: {{clave}}
}

body:graphql {
  query {
    prestamos(pagina: 0, tamanio: 10) {
      contenido { id codigo codigoEjemplar prestatario fechaPrestamo diasPrestamo multa estado observaciones version tituloLibro autorLibro }
      totalElementos
    }
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
}

docs {
  Grilla con todos los préstamos y dos atributos del libro (título y autor).
}
