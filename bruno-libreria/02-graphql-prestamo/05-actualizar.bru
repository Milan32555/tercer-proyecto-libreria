meta {
  name: Actualizar
  type: graphql
  seq: 5
}

post {
  url: {{urlLibreria}}/graphql
  body: graphql
  auth: basic
}

auth:basic {
  username: {{usuario}}
  password: {{clave}}
}

body:graphql {
  mutation ($input: PrestamoInput!) {
    actualizarPrestamo(input: $input) { id codigo codigoEjemplar prestatario fechaPrestamo diasPrestamo multa estado observaciones version tituloLibro autorLibro }
  }
}

body:graphql:vars {
  {
    "input": {
      "codigo": "{{codigoPrestamo}}",
      "codigoEjemplar": "{{codigoEjemplar}}",
      "prestatario": "Ana Pérez",
      "fechaPrestamo": "2026-01-10T08:30:00",
      "diasPrestamo": 7,
      "multa": 2500,
      "estado": "DEVUELTO",
      "observaciones": "Creado desde Bruno"
    }
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
}

docs {
  No permite cambiar el código ni el ejemplar.
}
